# Visual Studio читает этот файл: исходники всегда в UTF-8 (без BOM), иначе русские комментарии ломаются
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
